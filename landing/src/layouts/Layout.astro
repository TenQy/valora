---
import '../styles/global.css';
import AnimatedBackground from '../components/AnimatedBackground.astro';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "Descubre tu verdadero valor profesional en minutos con Valora. Estimaciones salariales y compatibilidad laboral potenciadas por IA."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO -->
		<title>{title} | Valora</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased overflow-x-hidden selection:bg-brand-primary selection:text-bg-base">
		<AnimatedBackground />
		<slot />
	</body>
</html>
