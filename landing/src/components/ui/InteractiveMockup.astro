---
interface Props {
  imageSrc: string;
  altText: string;
  trackingContainerId?: string;
  delayClass?: string;
}

const { imageSrc, altText, trackingContainerId = 'body', delayClass = '' } = Astro.props;
// Generate a unique ID for this instance in case there are multiple
const mockupId = `mockup-${Math.random().toString(36).substr(2, 9)}`;
const glareId = `glare-${mockupId}`;
---
<div class={`relative z-10 w-full ${delayClass}`}>
  <!-- Continuous levitation float -->
  <div class="animate-float">
    <!-- JS Controlled 3D Tilt container -->
    <div id={mockupId} data-container={trackingContainerId} class="interactive-mockup-container relative rounded-2xl overflow-hidden glass-card p-1 shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/5 will-change-transform transform-gpu">
      <img 
        src={imageSrc} 
        alt={altText} 
        class="w-full h-auto rounded-xl"
      />
      <!-- JS Controlled Glare effect -->
      <div id={glareId} class="mockup-glare absolute inset-0 pointer-events-none mix-blend-overlay opacity-0 transition-opacity duration-300"></div>
    </div>
  </div>
  
  <!-- Ambient shadow on the 'floor' to enhance levitation -->
  <div class="absolute -bottom-10 left-1/2 -translate-x-1/2 w-3/4 h-8 bg-black/40 blur-xl rounded-full animate-shadow-pulse -z-10"></div>
</div>

<style>
  /* Levitating Image */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-16px); }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* Ambient Floor Shadow pulse */
  @keyframes shadow-pulse {
    0%, 100% { opacity: 0.3; transform: translateX(-50%) scale(1); }
    50% { opacity: 0.1; transform: translateX(-50%) scale(0.8); }
  }
  .animate-shadow-pulse {
    animation: shadow-pulse 6s ease-in-out infinite;
  }
  
  /* Smooth reset for the JS parallax */
  .interactive-mockup-container {
    transition: transform 0.1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  body:not(:hover) .interactive-mockup-container {
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  // Setup all interactive mockups on the page
  const mockups = document.querySelectorAll('.interactive-mockup-container');
  
  mockups.forEach(mockup => {
    const containerId = (mockup as HTMLElement).dataset.container;
    const trackingElement = containerId === 'body' ? document.body : document.getElementById(containerId as string);
    const glare = mockup.querySelector('.mockup-glare') as HTMLElement;
    
    if (trackingElement && mockup && glare) {
      trackingElement.addEventListener('mousemove', (e: any) => {
        const centerX = window.innerWidth / 2;
        const centerY = window.innerHeight / 2;
        const mouseX = e.clientX;
        const mouseY = e.clientY;
        
        const rotateX = ((mouseY - centerY) / centerY) * -10; 
        const rotateY = ((mouseX - centerX) / centerX) * 10;
        
        requestAnimationFrame(() => {
          (mockup as HTMLElement).style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
          glare.style.opacity = '1';
          glare.style.background = `radial-gradient(circle at ${mouseX}px ${mouseY}px, rgba(255,255,255,0.15) 0%, transparent 40%)`;
        });
      });

      trackingElement.addEventListener('mouseleave', () => {
        requestAnimationFrame(() => {
          (mockup as HTMLElement).style.transform = `perspective(1200px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
          glare.style.opacity = '0';
        });
      });
    }
  });
</script>
