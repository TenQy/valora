---
import Badge from './ui/Badge.astro';
import PrimaryButton from './ui/PrimaryButton.astro';
import SecondaryButton from './ui/SecondaryButton.astro';
import InteractiveMockup from './ui/InteractiveMockup.astro';
---

<section id="hero-section" class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
    
    <!-- Text Content -->
    <div class="flex flex-col items-start text-left z-10">
      
      <Badge text="Plataforma impulsada por IA" />
      
      <!-- Headline -->
      <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-white mb-6 leading-[1.1] animate-fade-up" style="animation-delay: 0.1s;">
          Conoce tu verdadero<br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-hero-glow via-emerald-300 to-emerald-600 bg-size-[200%_auto] animate-shimmer drop-shadow-[0_0_12px_rgba(74,222,128,0.4)]">valor profesional.</span>
          <!-- Soft static glow -->
          <span class="absolute inset-0 bg-hero-glow blur-2xl opacity-10 -z-10 mix-blend-screen"></span>
      </h1>
      
      <!-- Description -->
      <p class="animate-fade-up opacity-0 [animation-fill-mode:forwards] [animation-delay:300ms] text-sm lg:text-base text-text-secondary mb-10 max-w-xl leading-relaxed font-light">
        Descubre tu posición en el mercado. Valora cruza tus competencias, experiencia e idiomas con datos en tiempo real para ofrecerte estimaciones salariales y proyecciones de carrera precisas.
      </p>
      
      <!-- Actions -->
      <div class="animate-fade-up opacity-0 [animation-fill-mode:forwards] [animation-delay:450ms] flex flex-col sm:flex-row gap-4 w-full sm:w-auto relative">
        
        <PrimaryButton 
          href="https://vaalora.vercel.app" 
          target="_blank" 
          rel="noopener noreferrer" 
          text="Probar en la Web" 
        />
        
        <SecondaryButton 
          href="/downloads/valora.apk" 
          download={true} 
          text="Descargar APK" 
        />
        
      </div>
      
    </div>

    <!-- Image / Mockup -->
    <InteractiveMockup 
      imageSrc="/images/hero_dashboard_real.png" 
      altText="Valora Dashboard Mockup" 
      trackingContainerId="hero-section"
      delayClass="animate-fade-in opacity-0 [animation-fill-mode:forwards] [animation-delay:600ms]"
    />
    
  </div>
</section>

<style>
</style>
