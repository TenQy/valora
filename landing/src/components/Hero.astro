---
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
  <!-- Glowing background elements -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-primary/20 rounded-full blur-[120px] opacity-50 -z-10"></div>
  <div class="absolute top-1/4 right-0 w-[600px] h-[600px] bg-brand-secondary/20 rounded-full blur-[100px] opacity-40 -z-10"></div>

  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
    
    <!-- Text Content -->
    <div class="flex flex-col items-start text-left z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-card border-brand-primary/30 text-brand-primary text-sm font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-primary animate-pulse"></span>
        Plataforma impulsada por IA
      </div>
      
      <h1 class="text-5xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.1] mb-6">
        Conoce tu verdadero <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-brand-secondary">valor profesional.</span>
      </h1>
      
      <p class="text-lg text-text-secondary mb-10 max-w-xl leading-relaxed">
        Valora analiza tus competencias, idiomas y experiencia usando Inteligencia Artificial para darte estimaciones salariales reales, compatibilidad laboral y rutas de crecimiento personalizadas.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a 
          href="https://vaalora.vercel.app" 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-brand-primary hover:bg-brand-primary-hover text-bg-base text-base font-bold transition-all shadow-[0_0_20px_rgba(3,218,197,0.3)] hover:shadow-[0_0_30px_rgba(3,218,197,0.5)] hover:-translate-y-1"
        >
          Probar en la Web
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        
        <a 
          href="/downloads/valora.apk" 
          download
          class="flex items-center justify-center gap-2 px-8 py-4 rounded-full glass-card hover:bg-white/10 text-white text-base font-semibold transition-all hover:-translate-y-1"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Descargar APK Android
        </a>
      </div>
      
      <p class="mt-6 text-sm text-text-secondary/60">
        Completamente gratis. No requiere tarjeta de crédito.
      </p>
    </div>

    <!-- Image / Mockup -->
    <div class="relative z-10 perspective-1000">
      <div class="relative rounded-2xl overflow-hidden glass-card p-2 transform rotate-y-[-10deg] rotate-x-[5deg] hover:rotate-y-0 hover:rotate-x-0 transition-transform duration-700 ease-out shadow-2xl">
        <img 
          src="/images/hero_dashboard_real.png" 
          alt="Valora Dashboard Mockup" 
          class="w-full h-auto rounded-xl border border-white/5 shadow-2xl"
        />
        <!-- Floating badge -->
        <div class="absolute -bottom-6 -left-6 glass-card p-4 flex items-center gap-4 animate-bounce" style="animation-duration: 3s;">
          <div class="w-12 h-12 rounded-full bg-brand-primary/20 flex items-center justify-center text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
          </div>
          <div>
            <p class="text-xs text-text-secondary font-medium uppercase tracking-wider">Estimación</p>
            <p class="text-white font-bold text-lg">$60,000 / año</p>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</section>
