---

---

<section class="py-20 relative" id="como-funciona">
  <!-- Subtle ambient background glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl h-[600px] bg-hero-glow/5 blur-[120px] rounded-full pointer-events-none -z-10"
  >
  </div>

  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-24">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">
        ¿Cómo Funciona?
      </h2>
      <p
        class="text-transparent bg-clip-text bg-gradient-to-r from-gray-400 to-white max-w-2xl mx-auto text-lg md:text-xl"
      >
        Tres simples pasos para descubrir lo que realmente vales en el mercado.
      </p>
    </div>

    <div class="relative">
      <!-- Vertical Glowing Timeline Line -->
      <div
        class="absolute left-8 md:left-1/2 top-0 bottom-0 w-[2px] bg-gradient-to-b from-hero-glow/0 via-hero-glow/20 to-hero-glow/0 md:-translate-x-1/2"
      >
      </div>

      <!-- Step 1 -->
      <div
        class="relative flex flex-col md:flex-row items-center justify-between w-full mb-12 group"
      >
        <!-- Glowing Node -->
        <div
          class="absolute left-8 md:left-1/2 w-6 h-6 rounded-full bg-[#0a0a0a] border-2 border-white/20 md:-translate-x-1/2 flex items-center justify-center z-10 group-hover:border-hero-glow group-hover:shadow-[0_0_20px_rgba(74,222,128,0.5)] transition-all duration-500 mt-2 md:mt-0"
        >
          <div
            class="w-2 h-2 rounded-full bg-white/50 group-hover:bg-hero-glow transition-colors duration-500"
          >
          </div>
        </div>

        <!-- Text Content -->
        <div class="w-full md:w-5/12 pl-20 md:pl-0 md:pr-16 md:text-right">
          <div
            class="text-hero-glow font-mono text-sm tracking-widest mb-3 uppercase"
          >
            Paso 01
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
            Construye tu Perfil
          </h3>
          <p
            class="text-gray-400 leading-relaxed group-hover:text-gray-200 transition-colors duration-500"
          >
            Agrega tus competencias, idiomas, años de experiencia y
            certificaciones. Cuanto más detallado, más precisa será la
            estimación.
          </p>
        </div>

        <!-- Visual Representation -->
        <div class="hidden md:flex w-5/12 justify-start pl-16">
          <div
            class="relative w-full max-w-sm rounded-2xl bg-[#0a0a0a] border border-white/5 p-6 flex flex-col overflow-hidden group-hover:-translate-y-2 group-hover:border-hero-glow/30 transition-all duration-500 shadow-2xl backdrop-blur-sm"
          >
            <!-- Glowing gradient top border -->
            <div
              class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-hero-glow to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>

            <div class="flex items-center gap-4 mb-6 relative z-10">
              <div
                class="w-14 h-14 rounded-full bg-gradient-to-br from-white/10 to-transparent flex items-center justify-center border border-white/10 relative overflow-hidden group-hover:border-hero-glow/50 transition-colors duration-500"
              >
                <!-- Scanning line on avatar -->
                <div
                  class="absolute inset-0 bg-hero-glow/20 h-[200%] -translate-y-full group-hover:animate-[fade-up_2s_ease-in-out_infinite]"
                >
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-300 group-hover:text-white transition-colors"
                  ><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"
                  ></path><circle cx="12" cy="7" r="4"></circle></svg
                >
              </div>
              <div class="space-y-3 w-full">
                <div
                  class="h-3 w-3/4 bg-white/10 rounded overflow-hidden relative"
                >
                  <div
                    class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmer_2s_infinite]"
                  >
                  </div>
                </div>
                <div class="h-2 w-1/2 bg-white/5 rounded"></div>
              </div>
            </div>

            <div class="flex flex-wrap gap-3 relative z-10">
              <span
                class="px-4 py-2 rounded-xl bg-white/5 border border-white/5 text-gray-400 text-xs font-medium group-hover:bg-hero-glow/10 group-hover:border-hero-glow/30 group-hover:text-hero-glow transition-all duration-300 delay-75"
                >Arquitectura</span
              >
              <span
                class="px-4 py-2 rounded-xl bg-white/5 border border-white/5 text-gray-400 text-xs font-medium group-hover:bg-blue-500/10 group-hover:border-blue-500/30 group-hover:text-blue-400 transition-all duration-300 delay-150"
                >B2 Inglés</span
              >
              <span
                class="px-4 py-2 rounded-xl bg-white/5 border border-white/5 text-gray-400 text-xs font-medium group-hover:bg-yellow-500/10 group-hover:border-yellow-500/30 group-hover:text-yellow-400 transition-all duration-300 delay-200"
                >+5 Años</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div
        class="relative flex flex-col md:flex-row-reverse items-center justify-between w-full mb-12 group"
      >
        <!-- Glowing Node -->
        <div
          class="absolute left-8 md:left-1/2 w-6 h-6 rounded-full bg-[#0a0a0a] border-2 border-white/20 md:-translate-x-1/2 flex items-center justify-center z-10 group-hover:border-hero-glow group-hover:shadow-[0_0_20px_rgba(74,222,128,0.5)] transition-all duration-500 mt-2 md:mt-0"
        >
          <div
            class="w-2 h-2 rounded-full bg-white/50 group-hover:bg-hero-glow transition-colors duration-500"
          >
          </div>
        </div>

        <!-- Text Content -->
        <div class="w-full md:w-5/12 pl-20 md:pl-16 md:text-left">
          <div
            class="text-hero-glow font-mono text-sm tracking-widest mb-3 uppercase"
          >
            Paso 02
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
            Análisis con IA
          </h3>
          <p
            class="text-gray-400 leading-relaxed group-hover:text-gray-200 transition-colors duration-500"
          >
            Nuestro motor impulsado por Gemini analiza tu perfil capa por capa y
            lo contrasta con miles de puntos de datos del mercado laboral
            actual.
          </p>
        </div>

        <!-- Visual Representation -->
        <div class="hidden md:flex w-5/12 justify-end pr-16">
          <div
            class="relative w-full max-w-sm rounded-2xl bg-[#0a0a0a] border border-white/5 p-10 flex items-center justify-center overflow-hidden group-hover:-translate-y-2 group-hover:border-hero-glow/30 transition-all duration-500 shadow-2xl backdrop-blur-sm min-h-[220px]"
          >
            <!-- Subtle spinning rings instead of massive blur -->
            <div
              class="absolute w-32 h-32 rounded-full border border-dashed border-hero-glow/20 group-hover:animate-[spin_4s_linear_infinite]"
            >
            </div>
            <div
              class="absolute w-48 h-48 rounded-full border border-dashed border-white/5 group-hover:animate-[spin_6s_linear_infinite_reverse]"
            >
            </div>

            <!-- Central Icon -->
            <div
              class="relative z-10 w-16 h-16 rounded-2xl bg-gradient-to-br from-white/10 to-transparent border border-white/10 flex items-center justify-center backdrop-blur-md shadow-lg group-hover:border-hero-glow/50 transition-colors duration-500"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-400 group-hover:text-hero-glow group-hover:scale-110 transition-all duration-500"
                ><path
                  d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                ></path><path d="M5 3v4"></path><path d="M19 17v4"></path><path
                  d="M3 5h4"></path><path d="M17 19h4"></path></svg
              >
            </div>

            <!-- Subtle particles -->
            <div
              class="absolute top-1/4 left-1/4 w-1 h-1 bg-hero-glow rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-ping transition-opacity delay-100"
            >
            </div>
            <div
              class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-hero-glow rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-ping transition-opacity delay-300"
            >
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div
        class="relative flex flex-col md:flex-row items-center justify-between w-full group"
      >
        <!-- Glowing Node -->
        <div
          class="absolute left-8 md:left-1/2 w-6 h-6 rounded-full bg-[#0a0a0a] border-2 border-white/20 md:-translate-x-1/2 flex items-center justify-center z-10 group-hover:border-hero-glow group-hover:shadow-[0_0_20px_rgba(74,222,128,0.5)] transition-all duration-500 mt-2 md:mt-0"
        >
          <div
            class="w-2 h-2 rounded-full bg-white/50 group-hover:bg-hero-glow transition-colors duration-500"
          >
          </div>
        </div>

        <!-- Text Content -->
        <div class="w-full md:w-5/12 pl-20 md:pl-0 md:pr-16 md:text-right">
          <div
            class="text-hero-glow font-mono text-sm tracking-widest mb-3 uppercase"
          >
            Paso 03
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
            Descubre tu Valor
          </h3>
          <p
            class="text-gray-400 leading-relaxed group-hover:text-gray-200 transition-colors duration-500"
          >
            Obtén instantáneamente una estimación salarial precisa, roles
            altamente compatibles con tu perfil y un plan de acción para seguir
            creciendo.
          </p>
        </div>
        <!-- Visual Representation -->
        <div class="hidden md:flex w-5/12 justify-start pl-16">
          <div
            class="relative w-full max-w-sm rounded-2xl bg-[#0a0a0a] border border-white/5 p-8 flex flex-col justify-center overflow-hidden group-hover:-translate-y-2 group-hover:border-hero-glow/30 transition-all duration-500 shadow-2xl backdrop-blur-sm min-h-[220px]"
          >
            <!-- Glowing gradient top border -->
            <div
              class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-hero-glow to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>

            <div
              class="text-sm text-gray-500 mb-2 font-medium uppercase tracking-wider relative z-10"
            >
              Estimación Actual
            </div>
            <div
              class="text-4xl font-bold text-white mb-4 relative z-10 flex items-center"
            >
              $85,000 <span class="text-lg text-gray-500 font-normal ml-2"
                >/ año</span
              >
            </div>

            <div
              class="flex items-center gap-2 text-hero-glow text-sm font-medium bg-hero-glow/10 border border-hero-glow/20 w-max px-4 py-2 rounded-full relative z-10 group-hover:-translate-y-1 group-hover:shadow-[0_5px_15px_rgba(74,222,128,0.2)] transition-all duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:animate-bounce"
                ><path d="m3 16 4-4 4 4 8-8"></path><path d="m15 8 h4 v4"
                ></path></svg
              >
              +24% vs mercado
            </div>

            <!-- Abstract Chart Area (Animated) -->
            <svg
              class="absolute bottom-0 left-0 w-full h-24 text-hero-glow/20 pointer-events-none"
              preserveAspectRatio="none"
              viewBox="0 0 100 100"
            >
              <!-- Filled area -->
              <path
                d="M0 100 L0 80 C 20 80, 30 60, 50 70 C 70 80, 80 40, 100 20 L100 100 Z"
                fill="currentColor"
                class="opacity-0 group-hover:opacity-100 transition-opacity duration-1000 delay-300"
              ></path>
              <!-- Line drawn on hover -->
              <path
                d="M0 80 C 20 80, 30 60, 50 70 C 70 80, 80 40, 100 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-dasharray="200"
                stroke-dashoffset="200"
                class="group-hover:animate-[dash_1.5s_ease-out_forwards]"
              ></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
